            "description": "200 response",
            "schema": {
              "$ref": "#/definitions/Empty"
            }
          }
        },
        "security": [
          {
            "api_gateway_authorizer": []
          }
        ]
      },
      "post": {
        "summary": "Create New Expense",
        "description": "Create a single expense record. Requires amount, merchant, and category. Supports 18+ currencies and 27 predefined expense categories. Auto-generates expense ID and timestamps.",
        "tags": ["Expenses"],
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "200 response",
            "schema": {
              "$ref": "#/definitions/Empty"
            }
          }
        },
        "security": [
          {
            "api_gateway_authorizer": []
          }
        ]
      },
      "options": {
        "summary": "CORS Preflight - List/Create Expenses",
