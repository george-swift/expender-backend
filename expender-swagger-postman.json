{
  "swagger": "2.0",
  "info": {
    "version": "1.0",
    "title": "Expender API",
    "description": "Serverless expense management platform with AI-powered receipt scanning (SmartScan), intelligent categorization, and multi-tier user quotas. Built on AWS with Lambda, DynamoDB, Textract, and OpenAI integration."
  },
  "host": "{{api_gateway_host}}",
  "basePath": "/dev",
  "schemes": ["https"],
  "tags": [
    {
      "name": "Expenses",
      "description": "Core expense management operations - create, read, update, delete expense records"
    },
    {
      "name": "Batch Operations",
      "description": "Bulk operations for processing multiple expenses efficiently"
    },
    {
      "name": "Export",
      "description": "Data export functionality for generating CSV files and reports"
    },
    {
      "name": "SmartScan",
      "description": "AI-powered receipt scanning with AWS Textract and OpenAI categorization"
    },
    {
      "name": "AI Processing",
      "description": "Machine learning and artificial intelligence features"
    },
    {
      "name": "Quotas",
      "description": "User plan management and usage tracking for free/pro tiers"
    },
    {
      "name": "User Management",
      "description": "User account and profile management operations"
    },
    {
      "name": "Webhooks",
      "description": "External service integration endpoints for real-time notifications"
    },
    {
      "name": "CORS",
      "description": "Cross-Origin Resource Sharing preflight requests"
    }
